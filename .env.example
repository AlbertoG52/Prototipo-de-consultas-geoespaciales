# Este archivo solo es referencia de cómo debe ser el .env; usted se encarga de
# cambiar los valores. El .env real nunca se sube a Git.

# --- base de datos ---
POSTGRES_USER=flora
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=flora_db

# --- firma de los tokens de sesión ---
# Debe ser larga y aleatoria. Si cambia, todas las sesiones abiertas se cierran.
SECRET_KEY=cambia_esta_clave_secreta_larga

# --- límite de consultas del visitante sin cuenta (RR_00_11) ---
# Tiene que ser menor que el límite del rol 'usuario' en la tabla roles (20).
LIMITE_CONSULTAS_ANONIMO=5

# --- expiración de la sesión por inactividad, en minutos (RR_00_04) ---
# Valor por defecto del sistema. Cada usuario puede elegir otro en su perfil.
# Para probarlo rápido en desarrollo se puede bajar a 1 o 2.
MINUTOS_INACTIVIDAD_SESION=30

# --- tiempo máximo de una consulta, en segundos (RR_38) ---
# Desde que llega al backend hasta que la respuesta está lista, incluidas
# todas las llamadas a CR-BioLM. Debe ser mayor que MCP_TIMEOUT_SEGUNDOS.
SEGUNDOS_MAXIMOS_CONSULTA=120

# --- bloqueo por intentos fallidos de inicio de sesión (RR_00_05) ---
# Tras INTENTOS_LOGIN_MAXIMOS contraseñas incorrectas seguidas, la cuenta queda
# bloqueada MINUTOS_BLOQUEO_LOGIN minutos.
INTENTOS_LOGIN_MAXIMOS=5
MINUTOS_BLOQUEO_LOGIN=2

# --- correo: verificación de cuenta y recuperación de contraseña (RR_00_07, RR_00_06) ---
# Cuenta de Gmail con verificación en dos pasos y una "contraseña de
# aplicación" (https://myaccount.google.com/apppasswords), sin espacios.
# Si SMTP_USUARIO o SMTP_PASSWORD quedan vacíos no se envía nada: el enlace
# aparece en el log del backend (docker compose logs backend).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=
SMTP_PASSWORD=
# Base de los enlaces que van en los correos.
URL_FRONTEND=http://localhost:5173

# --- base de datos en AWS (solo para el modo AWS) ---
# Solo se usa al levantar con docker-compose.aws.yml, con el túnel SSH abierto.
# En desarrollo local se deja comentada. Instrucciones en certs/README.md.
# host.docker.internal:5433 es el túnel, no se cambia.
# DATABASE_URL_AWS=postgresql://USUARIO_BD:CLAVE_BD@host.docker.internal:5433/NOMBRE_BD

# --- CR-BioLM por MCP (services/mcp_cliente.py) ---
# Dirección del servidor MCP de CR-BioLM. En desarrollo corre en la máquina
# anfitriona (ver "Conexión con CR-BioLM" en el README).
MCP_URL=http://host.docker.internal:8765/mcp
# Tiempo máximo de una llamada, en segundos (LLM ~40 s + mapa ~15 s).
MCP_TIMEOUT_SEGUNDOS=90
# Reintentos solo cuando no se pudo conectar, y espera entre ellos (segundos).
MCP_REINTENTOS_CONEXION=2
MCP_ESPERA_REINTENTO_SEGUNDOS=1
# Catálogo de especies: 'demo' (datos de ejemplo) o 'crbiolm' (CR-BioLM real,
# necesita el servidor de CR-BioLM levantado con las herramientas del fork).
CATALOGO=demo

# --- respuesta redactada por el LLM de CR-BioLM (RR_49) ---
# Tiempo máximo para que answer_question responda; si se pasa, la respuesta sale
# con el texto del Manual en vez de cortar la consulta. La llave de OpenRouter
# va en el .env de CR-BioLM, no aquí.
SEGUNDOS_MAXIMOS_REDACCION_IA=45

# --- registros de GBIF (RR_43, RR_58) ---
# Mínimo de registros válidos para generar el mapa; con menos, no hay mapa y se
# avisa al usuario.
MINIMO_REGISTROS_MAPA=5
# Reintentos cuando CR-BioLM no logra consultar GBIF, y espera entre ellos (segundos).
GBIF_REINTENTOS=2
GBIF_ESPERA_REINTENTO_SEGUNDOS=2

# --- tiempo de respuesta (RR_57) ---
# Una consulta que tarda más que esto se marca como lenta en el log y en
# GET /admin/tiempos.
SEGUNDOS_RESPUESTA_LENTA=30

# --- historial de uso por usuario (RR_76) ---
# true: el supermoderador ve el texto de las consultas de cada usuario.
# false: ve solo cuántas hizo, cuándo, con qué resultado y de qué especie.
ADMIN_VE_TEXTO_CONSULTAS=true
