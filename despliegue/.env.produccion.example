# Plantilla del .env de PRODUCCIÓN. En la EC2 se copia como .env.produccion
# (cp .env.produccion.example .env.produccion), se llenan los valores ahí y se
# protege con: chmod 600 .env.produccion
# .env.produccion NUNCA se sube a Git (lo ignora despliegue/.gitignore).

# --- dirección pública ---
# Sin dominio propio: la IP pública con guiones + .sslip.io (gratis, da HTTPS).
# Si la IP de la EC2 cambia (al detenerla e iniciarla), cambiar las tres líneas.
DOMINIO=IP-CON-GUIONES.sslip.io
URL_FRONTEND=https://IP-CON-GUIONES.sslip.io
ORIGENES_PERMITIDOS=https://IP-CON-GUIONES.sslip.io

# --- base de datos: la RDS ---
# Usuario flora_app (no postgres) y base flora_prod, creados como indica el
# README (sección 3). Si la contraseña tiene @ : / ? # & %, escribirlos
# codificados (@ -> %40, : -> %3A, / -> %2F, # -> %23, % -> %25).
DATABASE_URL=postgresql://flora_app:CONTRASEÑA-DE-FLORA-APP@ENDPOINT-DE-RDS:5432/flora_prod?sslmode=require

# --- firma de los tokens ---
# Nueva y distinta a la de desarrollo. Generarla con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- CR-BioLM ---
# demo:    datos de ejemplo; el sitio funciona sin CR-BioLM. Para empezar.
# crbiolm: datos reales. Mientras sea temporal, con el túnel SSH abierto desde
#          la computadora que presta CR-BioLM (README, sección 7).
CATALOGO=demo
# Con el túnel: http://host.docker.internal:8765/mcp
# Cuando José lo publique: su dirección. Solo cambia esta línea.
MCP_URL=http://host.docker.internal:8765/mcp

# --- correo (verificación y recuperación de contraseña) ---
# Sin estas dos, nadie nuevo puede verificar su cuenta: los enlaces salen en
# el log (docker compose ... logs backend). Los visitantes sí usan el chat.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=
SMTP_PASSWORD=

# --- el resto: los mismos valores que en desarrollo (.env.example) ---
LIMITE_CONSULTAS_ANONIMO=5
MINUTOS_INACTIVIDAD_SESION=30
SEGUNDOS_MAXIMOS_CONSULTA=120
INTENTOS_LOGIN_MAXIMOS=5
MINUTOS_BLOQUEO_LOGIN=15
MCP_TIMEOUT_SEGUNDOS=90
MCP_REINTENTOS_CONEXION=2
MCP_ESPERA_REINTENTO_SEGUNDOS=1
SEGUNDOS_MAXIMOS_REDACCION_IA=45
MINIMO_REGISTROS_MAPA=5
GBIF_REINTENTOS=2
GBIF_ESPERA_REINTENTO_SEGUNDOS=2
SEGUNDOS_RESPUESTA_LENTA=30
ADMIN_VE_TEXTO_CONSULTAS=true
