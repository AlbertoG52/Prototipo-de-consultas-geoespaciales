# Plantilla del .env. Copie este archivo como .env y complete los valores. El .env no se
# sube a Git.

# --- base de datos ---
POSTGRES_USER=flora
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=flora_db

# --- firma de los tokens de sesión ---
# Debe ser larga y aleatoria. Si cambia, todas las sesiones abiertas se cierran.
SECRET_KEY=cambia_esta_clave_secreta_larga

# --- consultas diarias del visitante sin cuenta ---
# Debe ser menor que el límite del rol 'usuario' (20 por defecto).
LIMITE_CONSULTAS_ANONIMO=5

# --- cierre de sesión por inactividad, en minutos ---
# Valor por defecto del sistema; cada usuario puede elegir otro en su perfil.
MINUTOS_INACTIVIDAD_SESION=30

# --- tiempo máximo de una consulta, en segundos ---
# Incluye todas las llamadas a CR-BioLM. Debe ser mayor que MCP_TIMEOUT_SEGUNDOS.
SEGUNDOS_MAXIMOS_CONSULTA=120

# --- bloqueo por intentos fallidos de inicio de sesión ---
# Tras INTENTOS_LOGIN_MAXIMOS contraseñas incorrectas seguidas, la cuenta se bloquea
# MINUTOS_BLOQUEO_LOGIN minutos.
INTENTOS_LOGIN_MAXIMOS=5
MINUTOS_BLOQUEO_LOGIN=2

# --- correo: verificación de cuenta y recuperación de contraseña ---
# Cuenta de Gmail con verificación en dos pasos y una contraseña de aplicación
# (https://myaccount.google.com/apppasswords), sin espacios. Si SMTP_USUARIO o SMTP_PASSWORD
# quedan vacíos, el enlace se escribe en el log del backend (docker compose logs backend).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=
SMTP_PASSWORD=
# Base de los enlaces de los correos.
URL_FRONTEND=http://localhost:5173

# --- base de datos en AWS (solo para el modo AWS) ---
# Se usa con docker-compose.aws.yml y el túnel SSH abierto (ver certs/README.md).
# host.docker.internal:5433 es el túnel y no se cambia.
# DATABASE_URL_AWS=postgresql://USUARIO_BD:CLAVE_BD@host.docker.internal:5433/NOMBRE_BD

# --- CR-BioLM por MCP ---
# Dirección del servidor MCP de CR-BioLM (ver "Conexión con CR-BioLM" en el README).
MCP_URL=http://host.docker.internal:8765/mcp
# Tiempo máximo de una llamada, en segundos (LLM ~40 s + mapa ~15 s).
MCP_TIMEOUT_SEGUNDOS=90
# Reintentos solo cuando no se pudo conectar, y espera entre ellos (segundos).
MCP_REINTENTOS_CONEXION=2
MCP_ESPERA_REINTENTO_SEGUNDOS=1
# Llamadas pesadas (mapa, GBIF, LLM) abiertas a la vez con CR-BioLM; las demás esperan
# turno. 0 = sin límite.
MCP_LLAMADAS_SIMULTANEAS=3

# --- respuesta redactada por el LLM de CR-BioLM ---
# Tiempo máximo para la redacción; si se pasa, se responde con el texto del Manual. La llave
# de OpenRouter va en el .env de CR-BioLM.
SEGUNDOS_MAXIMOS_REDACCION_IA=45

# --- registros de GBIF ---
# Mínimo de registros válidos para generar el mapa; con menos, no hay mapa y se avisa.
MINIMO_REGISTROS_MAPA=5
# Reintentos cuando CR-BioLM no logra consultar GBIF, y espera entre ellos (segundos).
GBIF_REINTENTOS=2
GBIF_ESPERA_REINTENTO_SEGUNDOS=2
# La frecuencia de actualización de los registros de GBIF se define en el .env de CR-BioLM
# (MPCR_GBIF_CACHE_MAX_DAYS).

# --- tiempo de respuesta ---
# Una consulta que tarda más que esto se marca como lenta en el log y en GET /admin/tiempos.
SEGUNDOS_RESPUESTA_LENTA=30

# --- historial de uso por usuario ---
# true: el supermoderador ve el texto de las consultas de cada cuenta.
# false: ve solo cuántas hizo, cuándo, con qué resultado y de qué especie.
ADMIN_VE_TEXTO_CONSULTAS=true
